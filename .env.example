# =============================================================================
# aiZee — MCP Secrets Template
# =============================================================================
# Copy this file to `.env` and fill in your real credentials.
# `.env` is git-ignored and will NEVER be committed.
#
# Location: <aizee-root>/.env  (project root)
# Loaded by: scripts/mcp_secrets_loader.py
# =============================================================================

# ---- LinkedIn (octopus-linkedin-mcp) ----
# Generate via: octopus-linkedin authorize
# Token is valid ~60 days, stored locally after first auth.
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
# Optional: custom token cache path (defaults to site-packages/token.json)
LINKEDIN_MCP_TOKEN_PATH=

# ---- Upwork (@furkankoykiran/upwork-mcp) ----
# Create an API app at: https://www.upwork.com/developer/documentation
# Then run: npx @furkankoykiran/upwork-mcp auth
UPWORK_CLIENT_ID=your_upwork_client_id_here
UPWORK_CLIENT_SECRET=your_upwork_client_secret_here

# ---- Freelancer (freelancer-mcp-server) ----
# Get OAuth token from: https://www.freelancer.com/settings/api
FREELANCER_OAUTH_TOKEN=your_freelancer_oauth_token_here
# Optional: multi-account JSON (overrides single token if set)
FREELANCER_ACCOUNTS=

# ---- Fiverr (fiverr-mcp-server) ----
# Fiverr MCP does not require secrets — it only needs `uvx` installed.
# If a future version requires a token, add it here:
# FIVERR_API_KEY=
