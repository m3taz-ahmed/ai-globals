{
  "pythonVersion": "3.10",
  "extraPaths": [
    "."
  ],
  "typeCheckingMode": "basic",
  "reportMissingImports": true,
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "temp",
    "backups"
  ],
  "executionEnvironments": [
    {
      "root": "tests",
      "typeCheckingMode": "off",
      "reportMissingImports": false
    },
    {
      "root": "runtime/tests",
      "typeCheckingMode": "off",
      "reportMissingImports": false
    },
    {
      "root": "memory/tests",
      "typeCheckingMode": "off",
      "reportMissingImports": false
    },
    {
      "root": "eval/tests",
      "typeCheckingMode": "off",
      "reportMissingImports": false
    },
    {
      "root": "aizee_mcp/tests",
      "typeCheckingMode": "off",
      "reportMissingImports": false
    },
    {
      "root": "scripts/tests",
      "typeCheckingMode": "off",
      "reportMissingImports": false
    }
  ]
}
