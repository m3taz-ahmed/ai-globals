{
  "pythonVersion": "3.10",
  "extraPaths": [
    "."
  ],
  "typeCheckingMode": "basic",
  "reportMissingImports": true,
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "temp",
    "backups"
  ],
  "ignore": [
    "tests",
    "runtime/tests",
    "memory/tests",
    "eval/tests",
    "aizee_mcp/tests",
    "scripts/tests"
  ]
}
